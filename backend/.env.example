# Server
PORT=5000
NODE_ENV=production

# MongoDB Atlas (preferred) or local
# Example Atlas: mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/permit-system?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/permit-system?retryWrites=true&w=majority
# Legacy alias (still supported):
# MONGODB_URL=mongodb://localhost:27017/permit-system

# Auth
JWT_SECRET=replace_with_a_long_random_secret

# Email (optional — password reset)
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_gmail_app_password

# Payments
# sandbox = mock online payments; live = real WaafiPay
PAYMENT_MODE=live
PAYMENT_URL=https://api.waafipay.net/asm
LIVE_PAYMENT_API_KEY=API-675418888AHX
WAAFI_MERCHANT_UID=M0910291
WAAFI_API_USER_ID=1000416
